// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`buildContext > snapshots a form with a selection 1`] = `
"XLSForm context
form_title: Household survey
form_id: household
version: (none)
languages: Default, Indonesian (id)
default_language: Default
active_sheet: survey

selected_rows: 1
survey#1
  type: integer
  name: age
  label: Age of the respondent
  label::Indonesian (id): Usia responden
  relevant: \${age} > 0

outline: rowIndex | type | name | label | groupPath
0 | begin_group | household | Household | 
1 | integer | age | Age of the respondent | household
3 | text | city | City | 

choices:
yes_no: [yes, no]

lint_errors: none"
`;

exports[`buildContext > snapshots a small form 1`] = `
"XLSForm context
form_title: Household survey
form_id: household
version: (none)
languages: Default, Indonesian (id)
default_language: Default
active_sheet: survey

selected_rows: none

outline: rowIndex | type | name | label | groupPath
0 | begin_group | household | Household | 
1 | integer | age | Age of the respondent | household
3 | text | city | City | 

choices:
yes_no: [yes, no]

lint_errors: none"
`;

