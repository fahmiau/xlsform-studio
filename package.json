{
  "name": "xlsform-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Offline-first desktop IDE for authoring XLSForm .xlsx files",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "bench": "tsx scripts/bench.ts",
    "bench:xlsx": "tsx scripts/bench-xlsx.ts",
    "bench:indexes": "tsx scripts/bench-indexes.ts",
    "bench:lint": "tsx scripts/bench-lint.ts",
    "bench:grid": "vitest bench --run src/features/grid/projection.bench.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "bindings": "cargo test --manifest-path src-tauri/Cargo.toml export_bindings",
    "bindings:check": "pnpm bindings && git diff --exit-code -- src/ipc/bindings.ts",
    "bump-version": "node scripts/bump-version.mjs",
    "fixtures": "tsx tests/fixtures/generate-reference.ts",
    "test:e2e": "playwright test",
    "verify": "node scripts/ci.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "2.0.110",
    "@ai-sdk/google": "2.0.106",
    "@ai-sdk/openai": "2.0.136",
    "@ai-sdk/openai-compatible": "1.0.59",
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@glideapps/glide-data-grid": "^6.0.3",
    "@radix-ui/react-dialog": "^1.1.20",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-virtual": "^3.14.21",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.6.0",
    "@tauri-apps/plugin-opener": "2.7.2",
    "@tauri-apps/plugin-store": "^2.5.0",
    "@tauri-apps/plugin-updater": "2.14.1",
    "@tauri-apps/plugin-window-state": "^2.5.0",
    "ai": "5.0.281",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "exceljs": "^4.4.0",
    "immer": "^11.2.6",
    "lucide-react": "^1.61.0",
    "nanoid": "^6.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "^4.14.8",
    "remark-gfm": "4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.13",
    "zundo": "^2.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "jsdom": "^28.1.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tauri-agent-kit": "0.1.0-alpha.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
