{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Grants the main window only: dialog pickers, non-secret preference store, window state, core defaults, user-initiated update checks (the updater runs in Rust, not the WebView), and opening the exact AI provider key/billing pages in the system browser (Q-AI1). No filesystem plugin: workbook I/O goes through scoped app commands (AD-7). No path opening, no wildcard hosts.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-set-title",
    "dialog:allow-open",
    "dialog:allow-save",
    "store:allow-load",
    "store:allow-get",
    "store:allow-set",
    "store:allow-save",
    "store:allow-delete",
    "updater:default",
    "window-state:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://aistudio.google.com/app/apikey" },
        { "url": "https://console.anthropic.com/settings/keys" },
        { "url": "https://console.anthropic.com/settings/billing" },
        { "url": "https://openrouter.ai/settings/keys" },
        { "url": "https://openrouter.ai/settings/credits" },
        { "url": "https://platform.openai.com/api-keys" },
        { "url": "https://platform.openai.com/settings/organization/billing/overview" },
        { "url": "https://console.groq.com/keys" },
        { "url": "https://console.groq.com/settings/billing" },
        { "url": "https://console.x.ai" },
        { "url": "https://console.x.ai/billing" },
        { "url": "https://platform.deepseek.com/api_keys" },
        { "url": "https://platform.deepseek.com/top_up" },
        { "url": "https://console.mistral.ai/api-keys" },
        { "url": "https://console.mistral.ai/billing" }
      ]
    }
  ]
}
